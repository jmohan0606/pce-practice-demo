// flows_for_advisor — C1 catalog query (docs/spec/ROUND_C_SPEC.md).
// Net-new-money flows by flow product for one month.
// Local-tier equivalent: app/graph/queries/catalog.py::flows_for_advisor
// advisor = advisor_sid or "all" (cohort only, in_cohort = true).
CREATE QUERY flows_for_advisor(STRING advisor, STRING month_id) FOR GRAPH phx_dm_pce_practice_demo {
  f = SELECT x FROM phx_dm_pce_advisor_flow_month:x -(phx_dm_pce_flow_by_advisor)- phx_dm_pce_advisor:a
      WHERE x.month_id == month_id
        AND ((advisor == "all" AND a.in_cohort) OR a.advisor_sid == advisor);
  PRINT f[f.flow_product_cd AS flow_product_cd, f.total_inflows AS inflows,
          f.total_outflows AS outflows, f.total_net_flows AS net_flows,
          f.credited_flows AS credited_flows];
}
