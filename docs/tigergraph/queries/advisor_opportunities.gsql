// advisor_opportunities — Round F2: the real CRM extract shape (replaces the
// Round E dummy-data version). Grouped by DERIVED stage_group — the source
// has NO Won/Lost stage and none is invented. forecast_amount (Salesforce
// Amount) and actual_assets (landed) are separate accumulators — NEVER summed
// together (they would double-count one opportunity).
// Local-tier equivalent: app/graph/queries/catalog.py::advisor_opportunities
// advisor = advisor_sid or "all" (cohort only, in_cohort = true).
CREATE QUERY advisor_opportunities(STRING advisor) FOR GRAPH phx_dm_pce_practice_demo {
  MapAccum<STRING, SumAccum<DOUBLE>> @@forecast;   // key = advisor|stage_group
  MapAccum<STRING, SumAccum<DOUBLE>> @@actual;
  MapAccum<STRING, SumAccum<INT>> @@count;
  MapAccum<STRING, SumAccum<INT>> @@stalled;

  o = SELECT x FROM phx_dm_pce_opportunity:x -(phx_dm_pce_opportunity_by_advisor)- phx_dm_pce_advisor:a
      WHERE (advisor == "all" AND a.in_cohort) OR a.advisor_sid == advisor
      ACCUM @@forecast += (x.advisor_sid + "|" + x.stage_group -> x.amount),
            @@actual   += (x.advisor_sid + "|" + x.stage_group -> x.actual_assets),
            @@count    += (x.advisor_sid + "|" + x.stage_group -> 1),
            @@stalled  += (x.advisor_sid + "|" + x.stage_group -> (x.is_stalled ? 1 : 0));

  PRINT @@forecast AS forecast_amount, @@actual AS actual_assets,
        @@count AS opportunity_count, @@stalled AS stalled_count,
        "CRM" AS data_source;
}
