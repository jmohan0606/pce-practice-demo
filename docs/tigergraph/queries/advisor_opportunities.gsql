// advisor_opportunities — Round E task 4 position query (docs/spec/ROUND_E_SPEC.md).
// Pipeline opportunities per advisor grouped by stage and status, with total
// amount and count. DUMMY DATA: every phx_dm_pce_opportunity row carries
// data_source = 'DUMMY' (schema change 5.1) — the UI surfaces the chip.
// Local-tier equivalent: app/graph/queries/catalog.py::advisor_opportunities
// advisor = advisor_sid or "all" (cohort only, in_cohort = true).
CREATE QUERY advisor_opportunities(STRING advisor) FOR GRAPH phx_dm_pce_practice_demo {
  MapAccum<STRING, SumAccum<DOUBLE>> @@amount;   // key = advisor|stage|status
  MapAccum<STRING, SumAccum<INT>> @@count;

  o = SELECT x FROM phx_dm_pce_opportunity:x -(phx_dm_pce_opportunity_by_advisor)- phx_dm_pce_advisor:a
      WHERE (advisor == "all" AND a.in_cohort) OR a.advisor_sid == advisor
      ACCUM @@amount += (x.advisor_sid + "|" + x.stage + "|" + x.status -> x.amount),
            @@count  += (x.advisor_sid + "|" + x.stage + "|" + x.status -> 1);

  PRINT @@amount AS total_amount_by_group, @@count AS opportunity_count_by_group,
        "DUMMY" AS data_source;
}
