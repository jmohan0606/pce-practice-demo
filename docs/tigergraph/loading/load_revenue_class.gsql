// Loading job for phx_dm_pce_revenue_class
// CSV contract: header row required, columns in DDL order (primary id first):
//   class_id,class_name
CREATE LOADING JOB load_phx_dm_pce_revenue_class FOR GRAPH phx_dm_pce_practice_demo {
  DEFINE FILENAME f;
  LOAD f TO VERTEX phx_dm_pce_revenue_class VALUES($"class_id", $"class_name") USING HEADER="true", SEPARATOR=",", QUOTE="double";
}
