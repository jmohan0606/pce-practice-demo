// Loading job for phx_dm_pce_monthly_revenue
// CSV contract: header row required, columns in DDL order (primary id first):
//   mr_id,advisor_sid,month_id,product_id,group_id,class_id,credited_amt,non_credited_amt,firm_credited_amt,advisor_credited_amt,txn_count,distinct_accounts
CREATE LOADING JOB load_phx_dm_pce_monthly_revenue FOR GRAPH phx_dm_pce_practice_demo {
  DEFINE FILENAME f;
  LOAD f TO VERTEX phx_dm_pce_monthly_revenue VALUES($"mr_id", $"advisor_sid", $"month_id", $"product_id", $"group_id", $"class_id", $"credited_amt", $"non_credited_amt", $"firm_credited_amt", $"advisor_credited_amt", $"txn_count", $"distinct_accounts") USING HEADER="true", SEPARATOR=",", QUOTE="double";
}
