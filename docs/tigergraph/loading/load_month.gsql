// Loading job for phx_dm_pce_month
// CSV contract: header row required, columns in DDL order (primary id first):
//   month_id,month_name,start_dt,end_dt,trading_days,is_baseline,is_partial
CREATE LOADING JOB load_phx_dm_pce_month FOR GRAPH phx_dm_pce_practice_demo {
  DEFINE FILENAME f;
  LOAD f TO VERTEX phx_dm_pce_month VALUES($"month_id", $"month_name", $"start_dt", $"end_dt", $"trading_days", $"is_baseline", $"is_partial") USING HEADER="true", SEPARATOR=",", QUOTE="double";
}
