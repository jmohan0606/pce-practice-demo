// Loading job for phx_dm_pce_opportunity (CRM pipeline — DUMMY data until a
// real CRM feed exists; data_source='DUMMY' on every row)
// CSV contract: header row required, columns in DDL order (primary id first):
//   opportunity_id,eci_id,advisor_sid,stage,status,amount,product_group,open_dt,expected_close_dt,close_dt,source,data_source
CREATE LOADING JOB load_phx_dm_pce_opportunity FOR GRAPH phx_dm_pce_practice_demo {
  DEFINE FILENAME f;
  LOAD f TO VERTEX phx_dm_pce_opportunity VALUES($"opportunity_id", $"eci_id", $"advisor_sid", $"stage", $"status", $"amount", $"product_group", $"open_dt", $"expected_close_dt", $"close_dt", $"source", $"data_source") USING HEADER="true", SEPARATOR=",", QUOTE="double";
}
