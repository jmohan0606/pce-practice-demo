// Loading job for phx_dm_pce_household
// CSV contract: header row required, columns in DDL order (primary id first):
//   eci_id,account_count
CREATE LOADING JOB load_phx_dm_pce_household FOR GRAPH phx_dm_pce_practice_demo {
  DEFINE FILENAME f;
  LOAD f TO VERTEX phx_dm_pce_household VALUES($"eci_id", $"account_count") USING HEADER="true", SEPARATOR=",", QUOTE="double";
}
