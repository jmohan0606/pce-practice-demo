// Loading job for phx_dm_pce_account_month
// CSV contract: header row required, columns in DDL order (primary id first):
//   am_id,acct_key,advisor_sid,month_id,end_balance,credited_amt,txn_count,is_zero_balance,present_prior_month
CREATE LOADING JOB load_phx_dm_pce_account_month FOR GRAPH phx_dm_pce_practice_demo {
  DEFINE FILENAME f;
  LOAD f TO VERTEX phx_dm_pce_account_month VALUES($"am_id", $"acct_key", $"advisor_sid", $"month_id", $"end_balance", $"credited_amt", $"txn_count", $"is_zero_balance", $"present_prior_month") USING HEADER="true", SEPARATOR=",", QUOTE="double";
}
