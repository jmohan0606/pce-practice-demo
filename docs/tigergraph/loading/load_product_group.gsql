// Loading job for phx_dm_pce_product_group
// CSV contract: header row required, columns in DDL order (primary id first):
//   group_id,group_name,display_prefix,class_id,sort_order,is_aggregated
CREATE LOADING JOB load_phx_dm_pce_product_group FOR GRAPH phx_dm_pce_practice_demo {
  DEFINE FILENAME f;
  LOAD f TO VERTEX phx_dm_pce_product_group VALUES($"group_id", $"group_name", $"display_prefix", $"class_id", $"sort_order", $"is_aggregated") USING HEADER="true", SEPARATOR=",", QUOTE="double";
}
