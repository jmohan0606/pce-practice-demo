// Loading job for phx_dm_pce_account_transfer
// CSV contract: header row required, columns in DDL order (primary id first):
//   transfer_id,acct_key,from_advisor_sid,to_advisor_sid,from_rr,to_rr,transfer_ts,month_id,is_intra_team,occd_cd
CREATE LOADING JOB load_phx_dm_pce_account_transfer FOR GRAPH phx_dm_pce_practice_demo {
  DEFINE FILENAME f;
  LOAD f TO VERTEX phx_dm_pce_account_transfer VALUES($"transfer_id", $"acct_key", $"from_advisor_sid", $"to_advisor_sid", $"from_rr", $"to_rr", $"transfer_ts", $"month_id", $"is_intra_team", $"occd_cd") USING HEADER="true", SEPARATOR=",", QUOTE="double";
}
