// Loading job for phx_dm_pce_account_eci_map
// CSV contract: header row required, columns in DDL order (primary id first):
//   map_id,acct_src_key,acct_src_raw,wm_src_sys_cd,eci_id,bus_dt,new_exst_adv_clnt_in
CREATE LOADING JOB load_phx_dm_pce_account_eci_map FOR GRAPH phx_dm_pce_practice_demo {
  DEFINE FILENAME f;
  LOAD f TO VERTEX phx_dm_pce_account_eci_map VALUES($"map_id", $"acct_src_key", $"acct_src_raw", $"wm_src_sys_cd", $"eci_id", $"bus_dt", $"new_exst_adv_clnt_in") USING HEADER="true", SEPARATOR=",", QUOTE="double";
}
