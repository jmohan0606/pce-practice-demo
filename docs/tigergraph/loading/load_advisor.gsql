// Loading job for phx_dm_pce_advisor
// CSV contract: header row required, columns in DDL order (primary id first):
//   advisor_sid,rep_code,advisor_name,branch_cd,employee_id,in_cohort,job_code,job_display_name,em_status_cd,is_departed,work_state,work_city,advisor_plan,is_synthetic
CREATE LOADING JOB load_phx_dm_pce_advisor FOR GRAPH phx_dm_pce_practice_demo {
  DEFINE FILENAME f;
  LOAD f TO VERTEX phx_dm_pce_advisor VALUES($"advisor_sid", $"rep_code", $"advisor_name", $"branch_cd", $"employee_id", $"in_cohort", $"job_code", $"job_display_name", $"em_status_cd", $"is_departed", $"work_state", $"work_city", $"advisor_plan", $"is_synthetic") USING HEADER="true", SEPARATOR=",", QUOTE="double";
}
