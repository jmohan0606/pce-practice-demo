// Loading job for phx_dm_pce_product
// CSV contract: header row required, columns in DDL order (primary id first):
//   product_id,product_cd,product_sub_cd,product_name,sor,file_key,group_id,grid_type
CREATE LOADING JOB load_phx_dm_pce_product FOR GRAPH phx_dm_pce_practice_demo {
  DEFINE FILENAME f;
  LOAD f TO VERTEX phx_dm_pce_product VALUES($"product_id", $"product_cd", $"product_sub_cd", $"product_name", $"sor", $"file_key", $"group_id", $"grid_type") USING HEADER="true", SEPARATOR=",", QUOTE="double";
}
